# Supabase — Project URL e chave anon/publishable (Settings > API no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...sua-chave-anon

# URL do backend FastAPI (local: http://localhost:8000; produção: URL do deploy do backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Modo manutenção — quando "true", toda rota (incluindo /login) redireciona para a
# tela "Estamos em obras". Ativar/desativar exige redeploy na Vercel (variável lida
# no proxy.ts, que roda no servidor). Deixe vazio/"false" em uso normal.
MAINTENANCE_MODE=false

# hCaptcha — Site Key pública (Sites > sua entrada em https://dashboard.hcaptcha.com).
# Não é a Secret Key — essa fica só no painel do Supabase (Authentication > Attack Protection).
# Sem essa variável, os forms de login/cadastro funcionam normalmente sem captcha (modo dev).
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# Logos de marca (bancos, bandeiras, assinaturas): provedor Logo.dev. A chave é
# publicável (segura no client). Já há um default no código; defina aqui para usar
# a sua própria conta. No plano gratuito, uso comercial exige link de atribuição
# ao Logo.dev. Alternativa: NEXT_PUBLIC_LOGO_BASE com {domain}/{size} para outro provedor.
NEXT_PUBLIC_LOGO_DEV_TOKEN=pk_d3XNtLL5TEmawlyLbImdFQ

# Cotações de mercado (Investimentos): o frontend NÃO chama a brapi.dev — ele só
# lê a tabela market_quote_cache no Supabase. Quem alimenta essa tabela é o job
# em scripts/refresh_market_quotes.py (GitHub Actions), que usa os secrets
# BRAPI_TOKEN e SUPABASE_SERVICE_ROLE_KEY configurados no GitHub, não aqui.
